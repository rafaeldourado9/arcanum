# Copy to .env and fill in. Never commit .env.
# Full reference: https://arcanum.rafaeldourado.tech/en/configuration/

# Required: key for every API route. Generate with: openssl rand -hex 32
GATEWAY_API_KEY=

# Webhook for every session ({instance} becomes the session name)
GATEWAY_WEBHOOK_FORWARD_URL=https://your-app.example.com/webhooks/whatsapp/{instance}
# simple | meta
GATEWAY_WEBHOOK_FORMAT=simple
# HMAC-SHA256 secret for the X-Hub-Signature-256 header. Generate with: openssl rand -hex 32
GATEWAY_META_APP_SECRET=

# Server
GATEWAY_PORT=3100
GATEWAY_DB_PATH=./data
GATEWAY_MAX_BODY_MB=64

# Logs: text | json   and   debug | info | warn | error
GATEWAY_LOG_FORMAT=text
GATEWAY_LOG_LEVEL=info

# Anti-ban
GATEWAY_RATE_LIMIT_PER_MIN=15
GATEWAY_MIN_DELAY_MS=1500
GATEWAY_MAX_DELAY_MS=4000
GATEWAY_TYPING_DURATION_MS=2000
GATEWAY_MS_PER_CHAR=50
GATEWAY_MAX_TYPING_MS=8000
