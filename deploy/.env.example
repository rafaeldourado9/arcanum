# Arcanum with Docker Compose (docker-compose.yml or docker-compose.caddy.yml).
#   cp .env.example .env    then fill the two required values below.
# Never commit .env. Full reference: https://arcanumgateway.com.br/en/configuration/
#
# Not here on purpose: GATEWAY_DB_PATH (the compose files always use /data, the volume)
# and GATEWAY_PORT (the compose files publish 3100).

# Required: key for every API route. Generate with: openssl rand -hex 32
GATEWAY_API_KEY=

# Required: dashboard login. Use a long password (e.g. openssl rand -hex 12).
GATEWAY_DASHBOARD_PASSWORD=

# Only for docker-compose.caddy.yml: your domain, with its DNS pointing to this server.
# Caddy gets and renews the Let's Encrypt certificate for it.
# ARCANUM_DOMAIN=wa.example.com

# Optional: webhook for every session ({instance} becomes the session name).
# GATEWAY_WEBHOOK_FORWARD_URL=https://your-app.example.com/webhooks/whatsapp/{instance}
# simple | meta
# GATEWAY_WEBHOOK_FORMAT=simple
# HMAC-SHA256 secret for the X-Hub-Signature-256 header. Generate with: openssl rand -hex 32
# GATEWAY_META_APP_SECRET=

# Logs: text | json   and   debug | info | warn | error
GATEWAY_LOG_FORMAT=json
GATEWAY_LOG_LEVEL=info

# Anti-ban (defaults shown; change only if you know why)
# GATEWAY_RATE_LIMIT_PER_MIN=15
# GATEWAY_MIN_DELAY_MS=1500
# GATEWAY_MAX_DELAY_MS=4000
# GATEWAY_TYPING_DURATION_MS=2000
# GATEWAY_MS_PER_CHAR=50
# GATEWAY_MAX_TYPING_MS=8000
